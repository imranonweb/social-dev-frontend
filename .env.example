# Next.js Public API URL (Points to Express Backend)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Better-Auth Configuration
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth Credentials (from GitHub Developer Settings)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# MongoDB Connection String (for Better-Auth session & accounts store)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/social_dev_db?retryWrites=true&w=majority

